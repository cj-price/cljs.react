{:tasks
 {:requires ([babashka.process :as p])

  dev
  {:doc "Watch and compile demo"
   :task (p/shell "pnpm exec shadow-cljs watch demo")}

  test
  {:doc "Run tests"
   :task (do
           (p/shell "pnpm exec shadow-cljs compile test")
           (p/shell "node target/test.js"))}

  test:watch
  {:doc "Watch and re-run tests on changes (autorun via :test build)"
   :task (p/shell "pnpm exec shadow-cljs watch test")}

  lint
  {:doc "Run clj-kondo over src / test / dev / hook code"
   :task (p/shell "clj-kondo --lint src test dev .clj-kondo/hooks")}

  check
  {:doc "CI gate: lint then run the full test suite"
   :task (do
           (run 'lint)
           (run 'test))}

  bench
  {:doc "Run performance benchmarks"
   :task (do
           (p/shell "pnpm exec shadow-cljs compile benchmark")
           (p/shell "node target/benchmark.js"))}

  bench-watch
  {:doc "Watch and re-run benchmarks on changes"
   :task (p/shell "pnpm exec shadow-cljs watch benchmark")}

  bench-baseline
  {:doc "Run benchmarks and save as new baseline"
   :task (do
           (p/shell "pnpm exec shadow-cljs compile benchmark")
           (p/shell "node target/benchmark.js --save-baseline"))}

  bench-regression
  {:doc "Bench the library at <ref> (default HEAD~1) vs the current tree (5 runs/side, best-of) and fail on regression. Never mutates the working tree."
   :task
   (let [ref       (or (first *command-line-args*) "HEAD~1")
         runs      5
         wt        "target/bench-base-worktree"
         cwd       (System/getProperty "user.dir")
         cur-outs  (mapv (fn [i] (str "target/bench-current-" i ".edn")) (range runs))
         ;; Absolute so the worktree-run base process writes into THIS repo's
         ;; target/, not the worktree's.
         base-outs (mapv (fn [i] (str cwd "/target/bench-base-" i ".edn")) (range runs))]
     ;; 1. Current tree: compile once, run `runs` times (separate processes).
     (p/shell "pnpm exec shadow-cljs compile benchmark")
     (run! (fn [out] (p/shell "node" "target/benchmark.js" "--emit" out)) cur-outs)
     ;; 2. Baseline in a throwaway worktree at <ref>. Overlay the CURRENT
     ;;    benchmark harness (src/cljs/benchmark + benchmark/) onto the base
     ;;    ref's LIBRARY (its src/cljs/react), then compile + run inside the
     ;;    worktree. The harness/bench-set stays constant across both sides, the
     ;;    worktree has its own .shadow-cljs cache + target/ (no stale build),
     ;;    and the working tree's source is never touched — a kill mid-run can't
     ;;    lose uncommitted work.
     ;;
     ;;    Two additions make the overlay library-ADDITIVE, so benching a ref
     ;;    that predates a new namespace still works:
     ;;      - deps.edn is copied, since the current harness may need a dep the
     ;;        base ref's deps.edn lacks.
     ;;      - missing library files are backfilled with `cp -rn` (no-clobber),
     ;;        so files that DO exist at the base ref keep the base
     ;;        implementation and are measured honestly.
     ;;    Without these the base side simply fails to compile, and one missing
     ;;    file destroys the baseline for EVERY bench, not just the new ones.
     ;;
     ;;    Known and intentional consequence: a backfilled namespace's benches
     ;;    exist on both sides, so they compare against themselves at ~1.00x and
     ;;    report "ok". They never reach regression.clj's "New benches (no
     ;;    baseline, not gated)" notice, so they LOOK gated while they are not.
     ;;    That is the right trade (never a false regression), but it is worth
     ;;    knowing before trusting a new bench's first green run.
     ;;
     ;;    shadow-cljs.edn is deliberately NOT copied: build targets and
     ;;    compiler options should stay the base ref's.
     (p/shell {:continue true} "git" "worktree" "remove" "--force" wt)
     (p/shell "git" "worktree" "add" "--force" "--detach" wt ref)
     (try
       (p/shell "bash" "-c"
                (str "rm -rf " wt "/src/cljs/benchmark && cp -r src/cljs/benchmark " wt "/src/cljs/benchmark"
                     " && rm -rf " wt "/benchmark && cp -r benchmark " wt "/benchmark"
                     " && cp deps.edn " wt "/deps.edn"
                     " && cp -rn src/cljs/react/. " wt "/src/cljs/react/"
                     " && ln -sfn \"" cwd "/node_modules\" " wt "/node_modules"))
       (p/shell {:dir wt} "pnpm" "exec" "shadow-cljs" "compile" "benchmark")
       (run! (fn [out] (p/shell {:dir wt} "node" "target/benchmark.js" "--emit" out)) base-outs)
       (finally
         (p/shell {:continue true} "git" "worktree" "remove" "--force" wt)))
     ;; 3. Compare best-of-N per side; a non-zero exit (regression) propagates.
     (p/shell "bb" "benchmark/regression.clj"
              (clojure.string/join "," base-outs)
              (clojure.string/join "," cur-outs)))}}}
