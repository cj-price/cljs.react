{;; Element Creation Thresholds
 :element/simple              {:max-overhead-pct 50  :max-time-ms 0.01}
 :element/with-props          {:max-overhead-pct 60  :max-time-ms 0.01}
 :element/with-children       {:max-overhead-pct 50  :max-time-ms 0.01}
 :element/nested              {:max-overhead-pct 50  :max-time-ms 0.05}

 ;; Props Conversion Thresholds
 :props/empty                 {:max-overhead-pct 100 :max-time-ms 0.005}
 :props/shallow               {:max-overhead-pct 100 :max-time-ms 0.01}
 :props/deep                  {:max-overhead-pct 150 :max-time-ms 0.02}
 :props/with-vectors          {:max-overhead-pct 150 :max-time-ms 0.02}
 :props/large                 {:max-overhead-pct 150 :max-time-ms 0.05}

 ;; Component Performance Thresholds
 :component/instantiation     {:max-overhead-pct 100 :max-time-ms 0.01}
 :component/tree-deep         {:max-overhead-pct 60  :max-time-ms 0.05}
 :component/tree-wide         {:max-overhead-pct 60  :max-time-ms 0.05}

 ;; Memoization Thresholds
 ;; Note: Higher overhead expected for structural equality vs shallow equality
 :memoization/equality-shallow-hit  {:max-overhead-pct 200 :max-time-ms 0.005}
 :memoization/equality-shallow-miss {:max-overhead-pct 200 :max-time-ms 0.005}
 :memoization/equality-deep-hit     {:max-overhead-pct 300 :max-time-ms 0.01}
 :memoization/equality-deep-miss    {:max-overhead-pct 300 :max-time-ms 0.01}
 :memoization/equality-identity     {:max-overhead-pct 100 :max-time-ms 0.002}

 ;; SX Styling Thresholds
 ;; :max-overhead-pct is deliberately omitted: the "baseline" for these is a
 ;; hand-rolled reference point, not an equivalent operation, so a ratio
 ;; against it carries no signal. Absolute time is the real gate — and it is
 ;; the stricter one anyway, since an overhead breach only warns while a
 ;; :max-time-ms breach fails.
 ;;
 ;; The warm probes are what a mounted component actually pays; the cold
 ;; compiles are included for scale, not as a per-render cost.
 :sx/class-for-warm           {:max-time-ms 0.0005}
 :sx/static-style-identity    {:max-time-ms 0.0001}
 :sx/compose-2                {:max-time-ms 0.005}
 :sx/compile-cold             {:max-time-ms 0.05}
 :sx/compile-cold-rich        {:max-time-ms 0.2}
 :sx/theme-vars-flatten       {:max-time-ms 0.5}}
