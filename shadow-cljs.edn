{:deps {:aliases [:dev :test]}

 :builds
 {:demo
  {:target :browser
   :output-dir "public/js"
   :asset-path "/js"
   :modules {:main {:init-fn cljs.react.demo/init}}
   :devtools {:http-root "public"
              :http-port 9011}}

  :test
  {:target :node-test
   :output-to "target/test.js"
   :autorun true}

  :benchmark
  ;; Deliberately :simple, not :advanced (which :release-demo uses). :advanced
  ;; DCE/renaming would prune or rewrite the benchmark harness and make results
  ;; hard to attribute, and :simple keeps iteration fast. Absolute numbers are
  ;; not production-representative; benchmarks are for relative HEAD-vs-HEAD~1
  ;; regression checks on the same machine (see CLAUDE.md).
  {:target :node-script
   :main cljs.benchmark.core/-main
   :output-to "target/benchmark.js"
   :compiler-options {:optimizations :simple
                      :source-map false}}

  :release-demo
  {:target :browser
   :output-dir "target/release-demo/js"
   :asset-path "js"
   :modules {:main {:init-fn cljs.react.demo/init}}
   :compiler-options {:optimizations :advanced
                      :infer-externs :auto}}}}